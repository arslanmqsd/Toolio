# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project settings: the "Connect" button in the Supabase dashboard > App Frameworks > Next.js.
# Both are public by design (they ship to the browser); row-level security protects the data.
# Never put a secret or service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Set to "on" once Authentication > Sign In / Providers > Google is configured in Supabase.
# Off by default: the sign-in dialog then offers only email link and password.
NEXT_PUBLIC_GOOGLE_SIGN_IN=off

# Public site origin, used for canonical URLs and the sitemap. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com
