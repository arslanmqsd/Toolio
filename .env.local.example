# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project settings: Project Settings > API in the Supabase dashboard.
# Both are public by design (they ship to the browser); row-level security protects the data.
# Never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site origin, used for canonical URLs and the sitemap. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com
